<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- ILRepack -->
    <!--
        SkipILRepack=true leaves the assemblies un-merged. ILRepack internalizes
        TidalSharp into the plugin DLL, which makes the plugin's public surface
        (e.g. TidalAPI.Client) reference types the test assembly cannot bind to.
        The test project sets this so it compiles and runs against the real
        TidalSharp assembly; shipping builds are unaffected.
    -->
    <Target Name="ILRepacker" AfterTargets="Build" Condition="'$(SkipILRepack)' != 'true'">
        <ItemGroup>
			<InputAssemblies Include="$(OutputPath)\Lidarr.Plugin.Tidal.dll" />
			<InputAssemblies Include="$(OutputPath)\TidalSharp.dll" />
			<InputAssemblies Include="$(OutputPath)\Newtonsoft.Json.dll" />
			<InputAssemblies Include="$(OutputPath)\TagLibSharp.dll" />
		</ItemGroup>

        <ILRepack
            Parallel="true"
            Internalize="true"
            InputAssemblies="@(InputAssemblies)"
            TargetKind="Dll"
            LibraryPath="..\..\ext\Lidarr\_output\net6.0\;$(OutputPath)"
            OutputFile="$(OutputPath)\$(AssemblyName).dll"
        />
    </Target>
    <!-- /ILRepack -->
</Project>