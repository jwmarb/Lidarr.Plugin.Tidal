<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      The repo-wide Directory.Build.props turns warnings into errors and wires up
      StyleCop via $(SolutionDir). Tests are not shipped artifacts, so we relax
      both here to keep the suite focused on behaviour rather than style.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);SA0001;SA1200;SA1633;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="5.10.3" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!--
      Lidarr's static Parser initialises NzbDroneLogger, which needs this NLog layout
      assembly at runtime. It is a transitive dependency of Lidarr.Common that does not
      flow to the test output on its own, so touching Parser.ParseAlbumTitle would throw
      TypeInitializationException without an explicit reference here.
    -->
    <PackageReference Include="NLog.Layouts.ClefJsonLayout" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      SkipILRepack stops the plugin build from merging+internalizing TidalSharp into
      Lidarr.Plugin.Tidal.dll. Without it the plugin's public surface references
      internalized copies of TidalSharp types and the test assembly fails at runtime
      with MissingMethodException on TidalAPI.get_Client().
    -->
    <ProjectReference Include="..\Lidarr.Plugin.Tidal\Lidarr.Plugin.Tidal.csproj">
      <SetProperties>SkipILRepack=true</SetProperties>
    </ProjectReference>
    <ProjectReference Include="..\TidalSharp\TidalSharp.csproj" />
  </ItemGroup>

  <!--
    The Tools/ subtree is a separate executable (the interactive PKCE login helper).
    Exclude it so the SDK's default globbing does not compile its Main into the test
    assembly, and so `dotnet test` does not try to build it as part of this project.
  -->
  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <None Remove="Tools\**\*" />
  </ItemGroup>

  <!-- Recorded (and credential-scrubbed) Tidal API payloads used by the offline tests. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
